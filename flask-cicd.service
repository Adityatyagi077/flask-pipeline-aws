[Unit]
Description=Flask CI/CD Application
After=network.target

[Service]
User=root
WorkingDirectory=/var/www/flask-cicd

Environment="PATH=/var/www/flask-cicd/venv/bin"

ExecStart=/var/www/flask-cicd/venv/bin/gunicorn --workers 2 --bind 0.0.0.0:5000 app:app

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
